# SÖZEL (lgs_sozel_crop_117x107) mm kalibrasyonu — PDF/ölçümden değerleri girin, ml-service ortamına yükleyin.
# OPTICAL_SOZEL_PAGE_W_MM=117.0
# OPTICAL_SOZEL_PAGE_H_MM=107.0
# OPTICAL_SOZEL_Q1_A_CX_COL0_MM=11.0
# OPTICAL_SOZEL_Q1_A_CY_MM=21.0
# OPTICAL_SOZEL_AD_CENTERS_SPAN_MM=15.0
# OPTICAL_SOZEL_Q1_Q20_CENTERS_SPAN_MM=84.0
# OPTICAL_SOZEL_GRID_OFFSET_X_MM=0.0
# OPTICAL_SOZEL_GRID_OFFSET_Y_MM=0.0
# OPTICAL_SOZEL_BUBBLE_RADIUS_SCALE=0.50
# Eşit olmayan sütunlar (mm, virgüllü; toplam sayfa genişliğine ölçeklenir):
# OPTICAL_SOZEL_COLUMN_WIDTHS_MM=29.25,29.25,29.25,29.25

# OMRChecker şablonu (API template=lgs_turkish_omrchecker) — isteğe bağlı; yoksa dahili 212×300 kullanılır
# pip install -r requirements-omrchecker.txt
# export OMR_CHECKER_TEMPLATE_JSON=/mutlak/yol/sizin_template.json
# Türkçe sütunu crop için ayrı şablon isterseniz:
# export OMR_CHECKER_COLUMN_TEMPLATE_JSON=/mutlak/yol/ml-service/omr_templates/lgs_turkish_column_20q_4pxmm.json
# export OMR_CHECKER_DISABLED=0
# Telefon en-boy oranı ≠ şablon: letterbox + geometri ölçekleme (varsayılan açık).
# export OMR_CHECKER_NO_LETTERBOX=0
# Dikey hizalama: top (üst) veya center — ölçüm “görüntü üstünden” ise genelde top.
# export OMR_CHECKER_LETTERBOX_ALIGN=top

# Türkçe A4 (lgs_turkish_212x300)
# OPTICAL_LGS_PAGE_W_MM=212.0
# OPTICAL_LGS_PAGE_H_MM=300.0
# OPTICAL_LGS_Q1_A_CX_MM=27.0
# OPTICAL_LGS_Q1_A_CY_MM=194.0
# OPTICAL_LGS_AD_CENTERS_SPAN_MM=15.0
# OPTICAL_LGS_Q1_Q20_CENTERS_SPAN_MM=85.0
# Tüm ızgarayı mm cinsinden kaydır (satır kayması için özellikle Y; ~ bir satır ≈ Q1_Q20_SPAN/19)
# OPTICAL_LGS_GRID_OFFSET_X_MM=0.0
# OPTICAL_LGS_GRID_OFFSET_Y_MM=0.0
# Şık başına dikey 'max doluluk' taraması (tam sayfa + TÜRKÇE sütunu LGS). Sorun çıkarsa kapatın:
# OPTICAL_LGS_DISABLE_VERTICAL_SLACK=1

# Yalnızca TÜRKÇE sütunu (lgs_turkish_column_crop) — Q1 A (6,11); A–D merkez aralığı 13 mm (şık adımı = span/3).
# Basılı A–E: mobil option_count=5 gönderilir; E merkezi D’den bir adım ötede modellenir. Q1–Q20 A merkez 80 mm.
# (Üst 11 mm + 80 mm = 91 mm dikey ızgara; pembe çerçeve tam 85 mm ise PAGE_H=85 ve Q1_Q20/offset ile env’den ince ayar.)
# OPTICAL_TR_COL_PAGE_W_MM=26.0
# OPTICAL_TR_COL_PAGE_H_MM=91.0
# OPTICAL_TR_COL_Q1_A_CX_MM=6.0
# OPTICAL_TR_COL_Q1_A_CY_MM=11.0
# OPTICAL_TR_COL_AD_CENTERS_SPAN_MM=13.0
# OPTICAL_TR_COL_Q1_Q20_CENTERS_SPAN_MM=80.0
# OPTICAL_TR_COL_GRID_OFFSET_X_MM=0.0
# OPTICAL_TR_COL_GRID_OFFSET_Y_MM=0.0
# OPTICAL_TR_COL_BUBBLE_RADIUS_SCALE=0.48
