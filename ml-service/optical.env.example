# SÖZEL (lgs_sozel_crop_117x107) mm kalibrasyonu — PDF/ölçümden değerleri girin, ml-service ortamına yükleyin.
# OPTICAL_SOZEL_PAGE_W_MM=117.0
# OPTICAL_SOZEL_PAGE_H_MM=107.0
# OPTICAL_SOZEL_Q1_A_CX_COL0_MM=11.0
# OPTICAL_SOZEL_Q1_A_CY_MM=21.0
# OPTICAL_SOZEL_AD_CENTERS_SPAN_MM=15.0
# OPTICAL_SOZEL_Q1_Q20_CENTERS_SPAN_MM=84.0
# OPTICAL_SOZEL_GRID_OFFSET_X_MM=0.0
# OPTICAL_SOZEL_GRID_OFFSET_Y_MM=0.0
# OPTICAL_SOZEL_BUBBLE_RADIUS_SCALE=0.50
# Eşit olmayan sütunlar (mm, virgüllü; toplam sayfa genişliğine ölçeklenir):
# OPTICAL_SOZEL_COLUMN_WIDTHS_MM=29.25,29.25,29.25,29.25

# OMRChecker şablonu (API template=lgs_turkish_omrchecker) — isteğe bağlı; yoksa dahili 212×300 kullanılır
# pip install -r requirements-omrchecker.txt
# export OMR_CHECKER_TEMPLATE_JSON=/mutlak/yol/sizin_template.json
# Türkçe sütunu crop için ayrı şablon isterseniz:
# export OMR_CHECKER_COLUMN_TEMPLATE_JSON=/mutlak/yol/ml-service/omr_templates/lgs_turkish_column_20q_4pxmm.json
# export OMR_CHECKER_DISABLED=0
# Telefon en-boy oranı ≠ şablon: letterbox + geometri ölçekleme (varsayılan açık).
# export OMR_CHECKER_NO_LETTERBOX=0
# Dikey hizalama: top (üst) veya center — ölçüm “görüntü üstünden” ise genelde top.
# export OMR_CHECKER_LETTERBOX_ALIGN=top

# Türkçe A4 (lgs_turkish_212x300)
# OPTICAL_LGS_PAGE_W_MM=212.0
# OPTICAL_LGS_PAGE_H_MM=300.0
# OPTICAL_LGS_Q1_A_CX_MM=27.0
# OPTICAL_LGS_Q1_A_CY_MM=194.0
# OPTICAL_LGS_AD_CENTERS_SPAN_MM=15.0
# OPTICAL_LGS_Q1_Q20_CENTERS_SPAN_MM=85.0
# Tüm ızgarayı mm cinsinden kaydır (satır kayması için özellikle Y; ~ bir satır ≈ Q1_Q20_SPAN/19)
# OPTICAL_LGS_GRID_OFFSET_X_MM=0.0
# OPTICAL_LGS_GRID_OFFSET_Y_MM=0.0
# Şık başına dikey 'max doluluk' taraması (tam sayfa + TÜRKÇE sütunu LGS). Sorun çıkarsa kapatın:
# OPTICAL_LGS_DISABLE_VERTICAL_SLACK=1

# Yalnızca TÜRKÇE sütunu (lgs_turkish_column_crop) — Q1 A (6,11); A–D merkez aralığı 13 mm (şık adımı = span/3).
# Basılı A–E: mobil option_count=5 gönderilir; E merkezi D’den bir adım ötede modellenir. Q1–Q20 A merkez 80 mm.
# (Üst 11 mm + 80 mm = 91 mm dikey ızgara; pembe çerçeve tam 85 mm ise PAGE_H=85 ve Q1_Q20/offset ile env’den ince ayar.)
# OPTICAL_TR_COL_PAGE_W_MM=26.0
# OPTICAL_TR_COL_PAGE_H_MM=91.0
# OPTICAL_TR_COL_Q1_A_CX_MM=6.0
# OPTICAL_TR_COL_Q1_A_CY_MM=11.0
# OPTICAL_TR_COL_AD_CENTERS_SPAN_MM=13.0
# OPTICAL_TR_COL_Q1_Q20_CENTERS_SPAN_MM=80.0
# OPTICAL_TR_COL_GRID_OFFSET_X_MM=0.0
# OPTICAL_TR_COL_GRID_OFFSET_Y_MM=0.0
# OPTICAL_TR_COL_BUBBLE_RADIUS_SCALE=0.48
#
# --- QR-benzeri hafif geometri / tutarlılık ---
# Dar sütunda (turuncu sol panel değil) hafif deskew: kod ve start-all varsayılanı açık; kapatmak için:
# OPTICAL_TR_COL_DESKEW=0
# İsteğe bağlı: ml-service/.env dosyası (KEY=VALUE) config yüklemesinde okunur; shell export önceliklidir.
# OPTICAL_TR_COL_DESKEW=1
# OPTICAL_TR_COL_DESKEW_MAX_DEG=5.5
# OPTICAL_TR_COL_DESKEW_DEAD_DEG=0.35
# Otomatik kırpım yapıldığında satır Y ince ayarı (hibrit skor toplamı) zaten açıktır; kapatmak için yok.
# Köşe QR ile sınav/öğrenci meta (yanıt API scan_metadata.qr_text):
# OPTICAL_TR_COL_SCAN_QR=1
# Sentinel satırı (baskıda sabit boş veya sabit şık); tutmazsa 400:
# OPTICAL_TR_COL_SENTINEL_ROW=1
# OPTICAL_TR_COL_SENTINEL_EXPECT=
# veya OPTICAL_TR_COL_SENTINEL_EXPECT=A
# Tek şıkta çökme şüphesi (neredeyse tüm cevaplar aynı şık) — reddetmek için:
# OPTICAL_TR_COL_REJECT_COLLAPSED=1
#
# --- Grid hizalama (lgs_turkish_column_crop, OpenCV grid_align) ---
# Varsayılan açık; eski sabit mm okuyucuya dönmek için:
# OPTICAL_TR_COL_USE_GRID_ALIGN=0
# Küresel (dx,dy) arama yarıçapı (px) ve adım:
# OPTICAL_TR_COL_ALIGN_SEARCH_PX=18
# OPTICAL_TR_COL_ALIGN_SEARCH_STEP=2
# Hizalama marjı toplanan satır üst sınırı (üst+alt+orta örnek; tam 20 satır marj toplamı sentetikte yanlış tepe seçebiliyor)
# OPTICAL_TR_COL_ALIGN_PROBE_ROWS=20
# En iyi marja yakın adaylar (plato); içinden en küçük |dx|+|dy| seçilir (yanlış tepeyi kırar)
# OPTICAL_TR_COL_ALIGN_PLATEAU_TAU=1.5
# scan_metadata.turkish_column.alignment.peak_analysis (tepe listesi, kural metni; yanıt boyutu büyür)
# OPTICAL_TR_COL_ALIGN_PEAK_ANALYSIS=1
# refine_y kapalıyken okuma dikey penceresi (üst yol use_vertical_slack=False iken)
# OPTICAL_TR_COL_READ_SLACK_HALF_WHEN_REFINE_OFF=0.56
# Son satırda dikey slack üst sınırı; alt kenarda tek sıkı hibrit (slack kapalı) için eşik
# OPTICAL_TR_COL_LAST_ROW_SLACK_HALF_MAX=0.38
# İlk satırın JSON özetini ml-service loguna yaz
# OPTICAL_TR_COL_DIAG_LOG=1
# İlk marj skoruna göre (0,0)’a geri snap (küçük iyileştirmeleri yok say):
# OPTICAL_TR_COL_ALIGN_SNAP_EPS=0.32
# Hizalama güveni bu altında 400 (kadraj çok kaymış):
# OPTICAL_TR_COL_ALIGN_REJECT_BELOW=0.022
# Şık merkezi ince X araması (0 = kapalı, 4–8 önerilir deneysel):
# OPTICAL_TR_COL_BUBBLE_X_SEARCH_PX=0
# OPTICAL_TR_COL_BUBBLE_X_SEARCH_STEP=2
# Hizalama için ek ikili ön-işleme (varsayılan kapalı):
# OPTICAL_TR_COL_ALIGN_PREPROCESS=0
#
# Debug görselleri ml-service/debug/ (varsayılan kapalı — her istekte disk yazmaz):
# OPTICAL_TR_COL_DEBUG_ARTIFACTS=1
#
# --- AI köşe hizalama (yalnız lgs_turkish_column_crop, sol turuncu panel hariç) ---
# Kapalı: mevcut crop/deskew + grid/OpenCV okuyucu aynen. Açık: köşe CNN + kanonik warp sonrası okuma.
# Başarısızlıkta (ağırlık yok, köşe geçersiz, düz warp vb.) sessizce klasik görüntüyle devam edilir.
# OPTICAL_TR_COL_AI_ALIGN=0
# Ağırlık: varsayılan ml-service/runs/turkish_column_corners/corner_mvp.pt
# OPTICAL_TR_COL_AI_WEIGHTS=/mutlak/yol/corner_mvp.pt
# Eşikler (piksel / gri std):
# OPTICAL_TR_COL_AI_MIN_QUAD_AREA_PX=500
# OPTICAL_TR_COL_AI_MIN_EDGE_PX=8
# OPTICAL_TR_COL_AI_BOUNDS_MARGIN_PX=0
# OPTICAL_TR_COL_AI_MIN_WARP_GRAY_STD=2
# Yanıt: scan_metadata.ai_align { ai_align_applied, ai_align_fallback_reason, ai_align_quad_area_px, ... }
#
# --- Şık / bubble okuma (lgs_turkish_column_crop, grid yolu) ---
# Hibrit skor eşikleri (düşük = daha çok boş; yüksek = gürültü şık riski). Varsayılanlar sentetik testlerle uyumlu.
# OPTICAL_TR_COL_MIN_BEST_SCORE=0.079
# OPTICAL_TR_COL_DOMINANCE_RATIO=1.145
# OPTICAL_TR_COL_DOMINANCE_GAP_ABS=0.02
# OPTICAL_TR_COL_AMBIG_SECOND_MULT=1.28
# OPTICAL_TR_COL_AMBIG_GAP_ABS_MIN=0.015
# OPTICAL_TR_COL_AMBIG_MARGIN_REL=0.092
# Daire yarıçapı çarpanı (kadraj kayması için hafif büyütme; mobilde 1.05–1.08 denenebilir)
# OPTICAL_TR_COL_BUBBLE_RADIUS_MULT=1.03
# ROI kırpma kutusu genişliği (px): şık merkezinden ekstra örnekleme
# OPTICAL_TR_COL_BUBBLE_ROI_PAD_PX=5
# Dikey slack örnek sayısı (satır Y kayması): 9 önerilir
# OPTICAL_TR_COL_VERTICAL_SLACK_SAMPLES=9
# Satır Y ince ayarı: üst aralık ve örnek sayısı (orta/alt satır drift)
# OPTICAL_TR_COL_REFINE_CY_HALF_MAX_PX=8.5
# OPTICAL_TR_COL_REFINE_CY_EXTRA_FOR_LOWER_ROWS_PX=1.25
# OPTICAL_TR_COL_REFINE_CY_NUM_SAMPLES=11
#
# Son 2–3 satır (18–20 bandı): boş okuma azaltma — tüm formu değil yalnızca alt bant (varsayılan son 3 satır).
# Önce yalnızca bu env’lerle ince ayar yapın; kod değişikliği ancak bunlar yetmezse düşünülmeli.
# OPTICAL_TR_COL_TAIL_ROWS=3
# OPTICAL_TR_COL_TAIL_MIN_BEST_RELAX=0.065
# OPTICAL_TR_COL_TAIL_DOM_RATIO_MULT=0.988
# OPTICAL_TR_COL_TAIL_DOM_GAP_SUB=0.005
# OPTICAL_TR_COL_BUBBLE_RADIUS_MULT_TAIL=1.025
# OPTICAL_TR_COL_REFINE_CY_EXTRA_FOR_TAIL_ROWS_PX=1.05
# OPTICAL_TR_COL_TAIL_VERTICAL_SLACK_HALF_ADD=0.042
# Tüm tail iyileştirmelerini kapatmak için: OPTICAL_TR_COL_TAIL_ROWS=0
#
# Çoklu ikili eşik + satır çoğunluğu (klasik dar sütun): aynı crop için adaptif (mevcut), Otsu, geniş blok adaptif;
# şık kararı çoğunluk / belirsizlik kurallarıyla birleştirilir. OPTICAL_TR_COL_BUBBLE_X_SEARCH_PX>0 iken kapalıdır.
# OPTICAL_TR_COL_MULTI_VARIANT_READ=0
#
# Form özeti: scan_metadata.turkish_column.reliability
# { confidence_mean, empty_count, ambiguous_count, ok_count, unstable_question_count, quality_hint, recommend_rescan, ... }
#
# Gelecek mobil çekim kalite kapısı (plan): blur=Laplacian varyansı; parlama=ROI doygun piksel oranı;
# crop=tamamlık (beklenen en-boy / köşe sentinel); tilt=deskew açısı; kontrast=gri std veya histogram aralığı.
# scan_metadata.turkish_column.row_debug_align[].decision_detail — boş/ambiguous nedeni (decision_code)
