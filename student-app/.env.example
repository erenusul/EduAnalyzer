# Üretim veya cihaz testi: backend kök URL (sonunda / olmadan)
# Örnek: https://api.ornek.com
EXPO_PUBLIC_BACKEND_URL=

# İstek zaman aşımı (milisaniye). Boş bırakılırsa 30000 kullanılır.
EXPO_PUBLIC_API_TIMEOUT_MS=

# Optik fotoğraf yükleme + ML (milisaniye). Boş bırakılırsa 120000 (2 dk).
EXPO_PUBLIC_UPLOAD_TIMEOUT_MS=

# iOS simulator: http://localhost:5131
# Android emulator: http://10.0.2.2:5131
# Fiziksel cihaz: http://<BILGISAYARIN_YEREL_IP>:5131
# Boş bırakılırsa Expo geliştirme host'u ile otomatik algılama denenir.

# true: Türkçe sütun optik taramalarını cihazda optical_tests/ altına kaydet (benchmark / ML testi)
# Üretimde false bırakın.
# Geliştirmede: repodaki .env.development içinde true; veya burada true yapıp .env olarak kopyalayın.
EXPO_PUBLIC_OPTICAL_TEST_SAVE_ENABLED=

# Dataset modu: yerel AI eğitim örnekleri (sunucuya gönderilmez). true | 1
EXPO_PUBLIC_DATASET_MODE_ENABLED=
# Duplicate eşiği 0–1 (varsayılan 0.9). Ortalama mutlak piksel farkına göre similarity = 1 - meanAbs.
EXPO_PUBLIC_DATASET_SIMILARITY_THRESHOLD=
# Parmak izi boyutu 8–128 (varsayılan 32).
EXPO_PUBLIC_DATASET_FINGERPRINT_SIZE=

# Hızlı fotoğraf biriktirme ekranı (DatasetCollector). Sunucuya istek yok. true | 1
EXPO_PUBLIC_DATASET_COLLECTOR_ENABLED=
