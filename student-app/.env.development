# Geliştirme ortamı (expo start): optik test kayıtlarını cihazda optical_tests/ altına yazar.
# Üretim sürümünde bu dosya kullanılmamalı veya değer false olmalıdır.
EXPO_PUBLIC_OPTICAL_TEST_SAVE_ENABLED=true

# Sınav Seç: Fotoğraf toplama + Dataset modu kartları
EXPO_PUBLIC_DATASET_COLLECTOR_ENABLED=1
EXPO_PUBLIC_DATASET_MODE_ENABLED=1
